<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HotelBookingMauiApp.ViewModels"
             x:Class="HotelBookingMauiApp.MainPage"
             Title="Rezerwacja pokoju">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Label Text="Rezerwacja pokoju hotelowego" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold" />

            <!-- Imię i nazwisko -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Imię i nazwisko:" />
                <Entry Text="{Binding FullName}" Placeholder="Jan Kowalski" />
            </VerticalStackLayout>

            <!-- Adres e-mail -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Adres e-mail:" />
                <Entry Text="{Binding Email}" Placeholder="jan@example.com" Keyboard="Email" />
            </VerticalStackLayout>

            <!-- Data przyjazdu -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Data przyjazdu:" />
                <DatePicker Date="{Binding CheckInDate}" />
            </VerticalStackLayout>

            <!-- Liczba nocy -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Liczba nocy:" />
                    <HorizontalStackLayout Spacing="10">
                        <Stepper Minimum="1" Maximum="14" Value="{Binding Nights}" />
                        <Label Text="{Binding Nights}" VerticalOptions="Center" WidthRequest="30" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Liczba osób -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Liczba osób:" />
                    <HorizontalStackLayout Spacing="10">
                        <Stepper Minimum="1" Maximum="4" Value="{Binding People}" />
                        <Label Text="{Binding People}" VerticalOptions="Center" WidthRequest="30" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Rodzaj pokoju -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Rodzaj pokoju:" />
                <Picker ItemsSource="{Binding RoomTypes}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedRoomType}" />
            </VerticalStackLayout>

            <!-- Śniadanie -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="Śniadanie:" VerticalOptions="Center" />
                <Switch IsToggled="{Binding HasBreakfast}" />
            </HorizontalStackLayout>

            <!-- Miejsce parkingowe -->
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding HasParking}" />
                <Label Text="Miejsce parkingowe" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Rabat -->
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Rabat:" />
                    <Label Text="{Binding Discount, StringFormat='{0:F0}%'}" FontAttributes="Bold" />
                </HorizontalStackLayout>
                <Slider Minimum="0" Maximum="20" Value="{Binding Discount}" />
            </VerticalStackLayout>

            <Button Text="Oblicz koszt" 
                    Command="{Binding CalculateCostCommand}" 
                    Margin="0,10,0,0" />

            <Label Text="{Binding Summary}" FontSize="16" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>