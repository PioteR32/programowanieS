<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SimpleKalkulator"
             x:Class="SimpleKalkulator.MainPage">
    <ContentPage.BindingContext>
        <views:MainPageViewModel/>
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label Text="Podaj pierwszą liczbę"/>
        <Entry x:Name="_firstNumber" Text="{Binding FirstNumber}"/>
        <Label Text="Podaj drugą liczbę"/>
        <Entry x:Name="_secondNumber" Text="{Binding SecondNumber}"/>
        <Button Command="{Binding AddNumber}"/>
        <Label x:Name="_result" Text="{Binding Result,StringFormat='Wynik: {0}'}"/>
    </VerticalStackLayout>
</ContentPage>
