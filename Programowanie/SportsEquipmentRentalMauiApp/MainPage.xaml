<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SportsEquipmentRentalMauiApp"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}"
             x:Class="SportsEquipmentRentalMauiApp.MainPage">
    <ContentPage.BindingContext>
        <local:MainPageViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ValueIsNotNullConverter x:Key="ValueIsNotNullConverter"/>

            <Color x:Key="Primary">#2196F3</Color>
            <Color x:Key="Secondary">#FF4081</Color>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- NAGŁÓWEK -->
            <VerticalStackLayout Spacing="5" Margin="0,10,0,10">
                <Label Text="Sports Rental" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource Primary}" 
                       HorizontalOptions="Center" />
                <Label Text="Oblicz koszt wypożyczenia" 
                       FontSize="16" 
                       TextColor="Gray" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- KARTA: DANE KLIENTA -->
            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="White" Padding="15">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Dane klienta" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}"/>
                    <Entry Text="{Binding NameAndSurname}"
                           TextColor="{StaticResource Secondary}"
                           Placeholder="Imię i nazwisko" 
                           FontSize="16" />
                </VerticalStackLayout>
            </Border>

            <!-- KARTA: WYBÓR SPRZĘTU -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Wybierz sprzęt" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}"/>
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.05" />
                    </Border.Shadow>
                    <CollectionView ItemsSource="{Binding Rentaltems}"
                                    SelectedItem="{Binding SelectedRentaltemItem}"
                                    SelectionMode="Single"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="15" ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" TextColor="Black" />
                                        <Label Text="Dostępny" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Price, StringFormat='{0} zł'}" 
                                           VerticalOptions="Center" 
                                           FontSize="17" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- KARTA: KONFIGURACJA (Dni i Ubezpieczenie) -->
            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="White" Padding="15">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    <!-- Sekcja Dni -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Liczba dni:" FontSize="16" />
                            <Label Text="{Binding RentalDays}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <Stepper Grid.Column="1" 
                                  Minimum="1" 
                                  Maximum="7" 
                                  Value="{Binding RentalDays}"
                                  ZIndex="1"
                                  BackgroundColor="{StaticResource Primary}"
                                  VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F0F0" />

                    <!-- Sekcja Ubezpieczenia -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding Insurance}" Color="{StaticResource Primary}" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Dodatkowe ubezpieczenie" FontSize="16" FontAttributes="Bold" />
                            <Label Text="+ 5 zł / dzień" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- PRZYCISK -->
            <Button Text="OBLICZ KOSZT" 
                    Command="{Binding CalculateCommand}"
                    CornerRadius="10"
                    HeightRequest="55"
                    FontAttributes="Bold"
                    FontSize="18"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White" />

            <!-- KARTA: PODSUMOWANIE -->
            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#E3F2FD" Padding="20" IsVisible="{Binding Summary, Converter={StaticResource ValueIsNotNullConverter}}">
                <!-- Uwaga: Jeśli nie masz IsNotNullConverter, użyj po prostu IsVisible="{Binding Summary, Converter={StaticResource StringToBoolConverter}}" 
                     lub w MAUI najprościej po prostu zostaw to w widoczności zależnej od treści -->
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Podsumowanie" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding Summary}" 
                           FontSize="15" 
                           TextColor="#333333"
                           LineHeight="1.4"
                           HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
