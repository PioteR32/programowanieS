<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VocabularyFlashCardsMauiApp.ViewModels"
             x:Class="VocabularyFlashCardsMauiApp.MainPage"
             Title="Vocabulary Flashcards">
<ContentPage.BindingContext>
        <vm:MainViewModel />
</ContentPage.BindingContext>
            <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        
        <CarouselView x:Name="FlashcardCarousel"
                      ItemsSource="{Binding Flashcards}"
                      CurrentItem="{Binding CurrentCard}"
                      
                      HeightRequest="200">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10" Padding="0" >
                        <Grid VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="{Binding EnglishWord}"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView 
                        IndicatorColor="Black"
                        SelectedIndicatorColor="Gray"
                        ItemsSource="{Binding Flashcards}"
                        Position="{Binding CurrentIndex}"
                         />

        <Label Text="{Binding CurrentCard.PolishWord}"
               FontSize="30"
               HorizontalOptions="Center"
               TextColor="DeepSkyBlue"
               IsVisible="{Binding IsTranslationVisible}"
               HeightRequest="50" />

        <Button Text="Pokaż tłumaczenie"
                Command="{Binding ShowTranslationCommand}"
                HorizontalOptions="Center" />

        <Button Text="Zacznij od początku"
                Command="{Binding RestartCommand}"
                BackgroundColor="Gray"
                TextColor="White"
                HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
